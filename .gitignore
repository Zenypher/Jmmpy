# Build outputs (anchored so similarly named source/resource folders remain trackable)
/target/
/out/
/build/
/dist/
/bin/
*.class

# Local IDE metadata
/.idea/
/.vscode/
*.iml
*.ipr
*.iws
/.classpath
/.project
/.settings/
/.factorypath
/.apt_generated/
/nbproject/private/
/nbbuild/
/nbdist/

# Application data: legacy working-directory files and portable data directories
/config.txt
/location.txt
/.jmp/
/.mmp/

# Local credentials and environment overrides; retain shareable templates
/.aws/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Runtime logs and JVM diagnostics
/logs/
*.log
hs_err_pid*.log
replay_pid*.log
*.hprof

# Editor temporary files
*~
*.swp
*.swo

# macOS and Windows filesystem metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Keep Maven wrapper files, source assets, and CI configuration version-controlled.
# Do not add blanket *.jar, *.zip, image, or media exclusions here.
